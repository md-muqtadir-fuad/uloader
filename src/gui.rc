/* U-loader window resources (windres src/gui.rc -O coff -o src/gui.res) */
#include <windows.h>
#include <commctrl.h>
#include "gui_res.h"

#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif

IDI_APP ICON "gui.ico"

/* RT_MANIFEST, CREATEPROCESS_MANIFEST_RESOURCE_ID: visual styles + Per-Monitor-V2 DPI */
1 24 "gui.manifest"

1 VERSIONINFO
FILEVERSION     1,3,0,0
PRODUCTVERSION  1,3,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "U-loader"
            VALUE "FileDescription",  "U-loader download manager"
            VALUE "FileVersion",      "1.3.0"
            VALUE "InternalName",     "uloader-gui"
            VALUE "OriginalFilename", "uloader-gui.exe"
            VALUE "ProductName",      "U-loader"
            VALUE "ProductVersion",   "1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/* ------------------------------------------------------------------ */
IDD_ADD DIALOGEX 0, 0, 316, 213
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add download"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Links (one per line):", IDC_STATIC, 10, 9, 296, 9
    EDITTEXT        IDC_LINKS, 10, 20, 296, 58, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "http, https and ftp links, magnet links or .torrent files", IDC_LINKS_HINT, 10, 81, 296, 9
    LTEXT           "&Save to:", IDC_STATIC, 10, 98, 296, 9
    EDITTEXT        IDC_DIR, 10, 109, 240, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 256, 109, 50, 14
    LTEXT           "&Connections:", IDC_STATIC, 10, 132, 56, 9
    EDITTEXT        IDC_CONNS, 10, 143, 46, 14, ES_NUMBER
    CONTROL         "", IDC_CONNS_SPIN, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    0, 0, 0, 0
    LTEXT           "Video &quality:", IDC_STATIC, 72, 132, 108, 9
    COMBOBOX        IDC_QUALITY, 72, 143, 108, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Mode:", IDC_STATIC, 196, 132, 110, 9
    COMBOBOX        IDC_MODE, 196, 143, 110, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTORADIOBUTTON "Start &now", IDC_START_NOW, 10, 168, 80, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Add &paused", IDC_ADD_PAUSED, 96, 168, 100, 10
    DEFPUSHBUTTON   "Download", IDOK, 200, 190, 50, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 256, 190, 50, 14
END

/* ------------------------------------------------------------------ */
IDD_SETTINGS DIALOGEX 0, 0, 330, 369
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Downloads", IDC_STATIC, 7, 6, 316, 118
    LTEXT           "Default &folder:", IDC_STATIC, 16, 20, 200, 9
    EDITTEXT        IDC_S_DIR, 16, 31, 240, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...", IDC_S_BROWSE, 262, 31, 52, 14
    AUTOCHECKBOX    "&Sort into folders by type: Video, Music, Documents, Compressed, Programs, Pictures",
                    IDC_S_CATS, 16, 50, 298, 10
    LTEXT           "&Connections per download (1-32):", IDC_STATIC, 16, 69, 190, 9
    EDITTEXT        IDC_S_CONNS, 262, 66, 52, 14, ES_NUMBER
    CONTROL         "", IDC_S_CONNS_SPIN, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    0, 0, 0, 0
    LTEXT           "&Maximum simultaneous downloads:", IDC_STATIC, 16, 87, 190, 9
    EDITTEXT        IDC_S_MAXACT, 262, 84, 52, 14, ES_NUMBER
    CONTROL         "", IDC_S_MAXACT_SPIN, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    0, 0, 0, 0
    AUTOCHECKBOX    "Speed &limiter: all downloads together at most (KB/s):", IDC_S_LIMITON, 16, 105, 240, 10
    EDITTEXT        IDC_S_LIMIT, 262, 102, 52, 14, ES_NUMBER

    GROUPBOX        "Behavior", IDC_STATIC, 7, 130, 316, 44
    AUTOCHECKBOX    "&Watch the clipboard and offer to download copied links", IDC_S_CLIP, 16, 143, 298, 10
    AUTOCHECKBOX    "Closing the window keeps downloading in the notification &area", IDC_S_TRAY, 16, 157, 298, 10

    GROUPBOX        "Browser integration", IDC_STATIC, 7, 180, 316, 54
    PUSHBUTTON      "Connect to b&rowsers", IDC_S_CONNECT, 16, 193, 92, 14
    LTEXT           "Registers U-loader with Chrome, Edge, Brave and Chromium.", IDC_STATIC, 114, 196, 202, 9
    LTEXT           "Extension folder:", IDC_STATIC, 16, 216, 60, 9
    LTEXT           "", IDC_S_EXTPATH, 76, 216, 186, 9, SS_PATHELLIPSIS | SS_NOPREFIX
    CONTROL         "<a>Open folder</a>", IDC_S_EXTLINK, "SysLink", WS_TABSTOP, 268, 216, 48, 10

    GROUPBOX        "Video sites", IDC_STATIC, 7, 240, 316, 38
    PUSHBUTTON      "Install / update &yt-dlp", IDC_S_YTDLP, 16, 253, 92, 14
    LTEXT           "", IDC_S_YTSTATUS, 114, 256, 202, 9, SS_ENDELLIPSIS

    LTEXT           "Output:", IDC_STATIC, 7, 284, 100, 9
    EDITTEXT        IDC_S_OUTPUT, 7, 295, 316, 48, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT           "", IDC_S_VERSION, 7, 351, 150, 9
    DEFPUSHBUTTON   "OK", IDOK, 217, 348, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 273, 348, 50, 14
END
